<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.rafalohaki.veloauth</groupId>
    <artifactId>veloauth</artifactId>
    <version>1.6.1</version>
    <packaging>jar</packaging>

    <name>VeloAuth</name>
    <description>Complete Velocity Authentication Plugin with BCrypt, Virtual Threads and multi-database support
    </description>
    
    <url>https://github.com/rafalohaki/VeloAuth</url>
    
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    
    <developers>
        <developer>
            <name>rafalohaki</name>
            <email>rafal@ohaki.pl</email>
            <url>https://github.com/rafalohaki</url>
        </developer>
    </developers>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-08-11T00:00:00Z</project.build.outputTimestamp>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!--
          Reproducible embedded-limbo network engine. VeloAuth supplies its own minimal 1.8
          PacketCodec and translates newer clients through the separately managed ViaVersion
          runtime. This immutable timestamped MCProtocolLib build is not a floating SNAPSHOT.
          Update only together with protocol/runtime tests and the recorded checksum.
        -->
        <mcprotocollib.version>26.2-20260809.160751-16</mcprotocollib.version>
        <mcprotocollib.resolved-version>${mcprotocollib.version}</mcprotocollib.resolved-version>
        <mcprotocollib.sha256>07ec18ba92c8b4041286eeff2470e08257fd1f383881515cba4a0a9bf6fa98c1</mcprotocollib.sha256>
        <!-- Compile/test contract for the Netty API supplied by Velocity at runtime. -->
        <embedded.netty.version>4.2.15.Final</embedded.netty.version>
        <!--
          The embedded protocol runtime is downloaded on first use, verified byte-for-byte and
          loaded from VeloAuth's private runtime directory. The coordinate remains a compile-only
          dependency so the main plugin JAR does not silently redistribute the separately licensed
          GPL-3.0 ViaVersion implementation. The normal build is pinned. A separately reviewed
          candidate may be recorded by maintainers for operator-opt-in staging; its digest is
          embedded in the VeloAuth release and is never accepted from the artifact origin.
        -->
        <viaversion.runtime.dependency-version>5.11.0</viaversion.runtime.dependency-version>
        <viaversion.runtime.version>5.11.0</viaversion.runtime.version>
        <viaversion.runtime.url>https://repo.viaversion.com/com/viaversion/viaversion-common/5.11.0/viaversion-common-5.11.0.jar</viaversion.runtime.url>
        <viaversion.runtime.sha256>a4dd9f63257ed923f73a64ecece31010acd04247db12855383172e1226912b3e</viaversion.runtime.sha256>
        <viaversion.reviewed.version>${viaversion.runtime.version}</viaversion.reviewed.version>
        <viaversion.reviewed.url>${viaversion.runtime.url}</viaversion.reviewed.url>
        <viaversion.reviewed.sha256>${viaversion.runtime.sha256}</viaversion.reviewed.sha256>
        <embedded.build.channel>stable</embedded.build.channel>
        <build.finalName>${project.artifactId}-${project.version}</build.finalName>
    </properties>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>opencollab-main</id>
            <url>https://repo.opencollab.dev/main/</url>
        </repository>
        <repository>
            <id>opencollab-mcprotocollib-snapshots</id>
            <url>https://repo.opencollab.dev/maven-snapshots/</url>
            <!-- The dependency uses an immutable timestamped coordinate. Maven classifies that
                 coordinate as a release even though OpenCollab stores it in the snapshot repo. -->
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </snapshots>
        </repository>
        <repository>
            <id>viaversion</id>
            <url>https://repo.viaversion.com/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- Velocity API -->
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>3.5.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!--
          Public proxy type universe. These APIs are used directly by VeloAuth and must resolve
          from Velocity at runtime; declaring them explicitly as provided prevents transitive
          compile scopes from accidentally bundling a second, incompatible copy.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>2.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>4.26.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-key</artifactId>
            <version>4.26.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-gson</artifactId>
            <version>4.26.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-legacy</artifactId>
            <version>4.26.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-plain</artifactId>
            <version>4.26.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.13.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- Database - ORMLite -->
        <dependency>
            <groupId>com.j256.ormlite</groupId>
            <artifactId>ormlite-jdbc</artifactId>
            <version>6.1</version>
        </dependency>

        <!-- Database drivers -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.5.0</version>
            <exclusions>
                <!-- protobuf is only needed for X DevAPI, which VeloAuth never uses -->
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.13</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.51.1.0</version>
        </dependency>

        <!-- BCrypt hashing -->
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>0.10.2</version>
        </dependency>

        <!-- JSR-305 Annotations for null safety -->
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
            <version>3.0.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- HikariCP Connection Pooling -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>6.3.0</version>
        </dependency>

        <!-- Caffeine: in-memory cache (W-TinyLFU, per-entry TTL, O(1) eviction)
             Used by AuthCache / SessionManager / BruteForceTracker / PremiumResolverService
             instead of hand-rolled LRU + ReentrantLock + scheduled cleanup. Relocated to
             net.rafalohaki.veloauth.libs.caffeine in the shade plugin below to prevent
             classloader conflicts with any other Velocity plugin bundling Caffeine. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.2.4</version>
        </dependency>

        <!-- Velocity 3.5 owns this Configurate/SnakeYAML type universe. -->
        <dependency>
            <groupId>org.spongepowered</groupId>
            <artifactId>configurate-core</artifactId>
            <version>4.2.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.spongepowered</groupId>
            <artifactId>configurate-yaml</artifactId>
            <version>4.2.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- bStats -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-velocity</artifactId>
            <version>3.2.1</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-base</artifactId>
            <version>3.2.1</version>
        </dependency>

        <!-- MCProtocolLib exposes Cloudburst vectors in types used by the embedded runtime. -->
        <dependency>
            <groupId>org.cloudburstmc.math</groupId>
            <artifactId>immutable</artifactId>
            <version>2.0</version>
        </dependency>

        <!--
          Embedded auth/limbo network engine. MCProtocolLib is isolated in the shaded JAR; Netty,
          Adventure and SLF4J remain proxy-provided and are excluded from the shaded artifact below.
          The exact binary checksum is documented and checked by scripts/verify-embedded-dependencies.sh.
        -->
        <dependency>
            <groupId>org.geysermc.mcprotocollib</groupId>
            <artifactId>protocol</artifactId>
            <version>${mcprotocollib.version}</version>
            <exclusions>
                <!-- Use Velocity's shared Netty runtime below. Native transports and the
                     all-modules aggregator are unnecessary for a loopback-only listener. -->
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty.incubator</groupId>
                    <artifactId>netty-incubator-transport-native-io_uring</artifactId>
                </exclusion>
                <!-- Client-side Microsoft authentication is unreachable in VeloAuth's
                     server-only, Velocity-forwarded login flow. -->
                <exclusion>
                    <groupId>net.raphimc</groupId>
                    <artifactId>MinecraftAuth</artifactId>
                </exclusion>
                <!-- cloudburst-math:immutable 2.0 already contains the complete api module
                     byte-for-byte, plus the immutable implementations. Keeping both produces
                     duplicate classes in the shaded plugin without adding runtime behavior. -->
                <exclusion>
                    <groupId>org.cloudburstmc.math</groupId>
                    <artifactId>api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
          Netty channel objects cross the MCProtocolLib -> downloaded ViaVersion boundary, so all
          three components must use Velocity's single Netty type universe. These provided modules
          are compile/test-only and are deliberately neither bundled nor relocated.
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-common</artifactId>
            <version>${embedded.netty.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
            <version>${embedded.netty.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
            <version>${embedded.netty.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-base</artifactId>
            <version>${embedded.netty.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
            <version>${embedded.netty.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Compile-only API + implementation surface for the child-classloader bootstrap. -->
        <dependency>
            <groupId>com.viaversion</groupId>
            <artifactId>viaversion-common</artifactId>
            <version>${viaversion.runtime.dependency-version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.12.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>5.12.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.12.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.12.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.12.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <finalName>${build.finalName}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <filtering>false</filtering>
                <targetPath>META-INF/veloauth</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>THIRD_PARTY_NOTICES.md</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <!-- Template plugin to inject version into Java code -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>templating-maven-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>filter-src</id>
                        <goals>
                            <goal>filter-sources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <propertiesEncoding>UTF-8</propertiesEncoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-jdk21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>VeloAuth requires JDK 21 or newer to build. Note: PMD currently has known issues with class files compiled by JDK 22+ (Unsupported class file major version). For PMD static analysis builds, use JDK 21 explicitly.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-Xlint:deprecation</arg>
                        <arg>-Xlint:unchecked</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <outputTimestamp>${project.build.outputTimestamp}</outputTimestamp>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-artifact-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>check-reproducible-build-plan</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check-buildplan</goal>
                        </goals>
                        <configuration>
                            <tasks>package</tasks>
                            <diagnose>true</diagnose>
                            <failOnNonReproducible>true</failOnNonReproducible>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>analyze-direct-dependencies</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <failOnWarning>true</failOnWarning>
                    <ignoreNonCompile>false</ignoreNonCompile>
                    <ignoredUnusedDeclaredDependencies>
                        <!-- JDBC drivers are loaded by trusted class name and java.sql.Driver SPI. -->
                        <ignoredUnusedDeclaredDependency>com.mysql:mysql-connector-j</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>org.postgresql:postgresql</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>com.h2database:h2</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>org.xerial:sqlite-jdbc</ignoredUnusedDeclaredDependency>
                        <!-- MCProtocolLib uses timeout/proxy handlers from this provided Netty module. -->
                        <ignoredUnusedDeclaredDependency>io.netty:netty-handler</ignoredUnusedDeclaredDependency>
                        <!-- Surefire discovers the Jupiter engine through TestEngine SPI. -->
                        <ignoredUnusedDeclaredDependency>org.junit.jupiter:junit-jupiter-engine</ignoredUnusedDeclaredDependency>
                    </ignoredUnusedDeclaredDependencies>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.3</version>
                <executions>
                    <execution>
                        <id>production-sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>application</projectType>
                    <schemaVersion>1.6</schemaVersion>
                    <outputFormat>json</outputFormat>
                    <outputName>${project.artifactId}-${project.version}.cdx</outputName>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeProvidedScope>true</includeProvidedScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeSystemScope>false</includeSystemScope>
                    <includeTestScope>false</includeTestScope>
                    <includeLicenseText>false</includeLicenseText>
                    <skipAttach>false</skipAttach>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <!-- The port-collision test asserts this failure structurally; suppress only
                         MCProtocolLib's duplicate expected stack trace in the test JVM. -->
                    <argLine>@{argLine} --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED -Djdk.attach.allowAttachSelf=true -XX:+EnableDynamicAgentLoading -Dnet.bytebuddy.experimental=true -Dnet.bytebuddy.safe=true -Xshare:off -Dorg.slf4j.simpleLogger.logFile=System.out -Dorg.slf4j.simpleLogger.defaultLogLevel=error -Dorg.slf4j.simpleLogger.log.org.geysermc.mcprotocollib.network.server.NetworkServer=off</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!--
                      Bundle-level line-coverage floor. Set to 50% to lock in the current
                      state (≈54% as of 2026-05-16) and prevent regression. Bump in steps
                      as new tests land — don't try to enforce a higher target retroactively.
                      Tied to `verify` so `mvnd clean verify` fails on regression.
                    -->
                    <execution>
                        <id>coverage-floor</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.50</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <!--
                                      Velocity provides slf4j-api on the proxy classpath — bundling a
                                      second copy (transitive from HikariCP) risks LinkageError.
                                      checker-qual / error_prone_annotations are compile-time-only
                                      annotation carriers (transitive from Caffeine) — dead weight.
                                    -->
                                    <exclude>org.slf4j:slf4j-api</exclude>
                                    <exclude>org.checkerframework:checker-qual</exclude>
                                    <exclude>com.google.errorprone:error_prone_annotations</exclude>
                                    <!-- Velocity owns the Adventure API and public serializers;
                                         components cross that classloader boundary. -->
                                    <exclude>net.kyori:adventure-api</exclude>
                                    <exclude>net.kyori:adventure-key</exclude>
                                    <exclude>net.kyori:adventure-text-serializer-gson</exclude>
                                    <exclude>net.kyori:adventure-text-serializer-json</exclude>
                                    <exclude>net.kyori:adventure-text-serializer-legacy</exclude>
                                    <exclude>net.kyori:adventure-text-serializer-plain</exclude>
                                    <exclude>net.kyori:adventure-text-serializer-commons</exclude>
                                    <!-- Adventure's proxy-provided Gson serializer exposes Gson
                                         types in its public method descriptors. MCProtocolLib must
                                         use Velocity's matching Gson type universe as well; bundling
                                         or relocating Gson creates a NoSuchMethodError after Join Game. -->
                                    <exclude>com.google.code.gson:gson</exclude>
                                    <!-- Velocity owns Configurate and its YAML parser. -->
                                    <exclude>org.spongepowered:configurate-*</exclude>
                                    <exclude>org.yaml:snakeyaml</exclude>
                                    <exclude>net.kyori:option</exclude>
                                    <exclude>net.kyori:examination-api</exclude>
                                    <exclude>net.kyori:examination-string</exclude>
                                    <!-- ViaVersion is a separately downloaded, checksum-pinned runtime. -->
                                    <exclude>com.viaversion:*</exclude>
                                </excludes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.bstats</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.j256.ormlite</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.ormlite</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>at.favre.lib.crypto</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.bcrypt</shadedPattern>
                                </relocation>
                                <!--
                                  at.favre.lib:bytes (transitive from bcrypt) lives outside the
                                  at.favre.lib.crypto pattern above — relocate it separately so no
                                  un-relocated at.favre class ships in the JAR.
                                -->
                                <relocation>
                                    <pattern>at.favre.lib.bytes</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.bytes</shadedPattern>
                                </relocation>
                                <!--
                                  HikariCP relocation prevents LinkageError when another Velocity plugin
                                  bundles a different Hikari version. Safe because VeloAuth only uses the
                                  Hikari API via type imports (DatabaseConfig.java) — no string-FQN refs.
                                  JDBC drivers (postgresql, mysql, h2, sqlite) are NOT relocated:
                                  DatabaseType.java stores driver class names as string literals which
                                  shade does not rewrite, and JDBC SPI discovery in META-INF/services
                                  already handles cross-plugin coexistence.
                                -->
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.hikari</shadedPattern>
                                </relocation>
                                <!--
                                  Caffeine relocation. Same rationale as Hikari above: another
                                  Velocity plugin could bundle its own Caffeine and the isolated
                                  classloader would otherwise see two incompatible copies of
                                  com.github.benmanes.caffeine.cache.* classes.
                                -->
                                <relocation>
                                    <pattern>com.github.benmanes.caffeine</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.caffeine</shadedPattern>
                                </relocation>
                                <!-- MCProtocolLib and its private runtime implementation packages. -->
                                <relocation>
                                    <pattern>org.geysermc.mcprotocollib</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.mcprotocollib</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.cloudburstmc.nbt</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.cloudburst.nbt</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.cloudburstmc.math</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.cloudburst.math</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>it.unimi.dsi.fastutil</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.fastutil</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.nukkitx.fastutil</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.nukkitx.fastutil</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.raphimc.minecraftauth</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.minecraftauth</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.lenni0451.commons</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.lenni0451</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.kyori.adventure.text.serializer.json.legacyimpl</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.kyori.json.legacyimpl</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.kyori.adventure.nbt</pattern>
                                    <shadedPattern>net.rafalohaki.veloauth.libs.kyori.nbt</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/LICENSE</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/LICENSE.txt</exclude>
                                        <exclude>META-INF/NOTICE.txt</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- PMD for static code analysis and CPD for duplicate detection -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <dependencies>
                    <!-- PMD 7.21+ supports parsing JDK 21..26 class files; required when local JDK is 22+. -->
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>7.22.0</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>7.22.0</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- PMD analysis configuration -->
                    <rulesets>
                        <ruleset>${project.basedir}/pmd-ruleset.xml</ruleset>
                    </rulesets>
                    <targetJdk>21</targetJdk>
                    <printFailingErrors>true</printFailingErrors>
                    <linkXRef>false</linkXRef>
                    <includeTests>true</includeTests>
                    <failOnViolation>true</failOnViolation>
                    
                    <!-- CPD (Copy-Paste Detector) configuration -->
                    <minimumTokens>50</minimumTokens> <!-- Minimum size for duplicate detection (50 tokens = ~5-10 lines) -->
                    <skipEmptyReport>false</skipEmptyReport>
                    <excludeRoots>
                        <excludeRoot>target/generated-sources</excludeRoot>
                    </excludeRoots>
                    <excludes>
                        <exclude>**/*Test.java</exclude> <!-- Optionally exclude test files from CPD -->
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <!-- PMD `check` is bound to verify. CPD remains an explicit, separate
                                 release gate so duplicate analysis can be run and diagnosed on
                                 its own: `mvnd pmd:check pmd:cpd-check`. Both are expected to pass. -->
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
